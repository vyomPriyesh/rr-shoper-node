<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>RR Shoper | Tax Invoice - <%= vendor.name %></title>
    <style>
        @page {
            size: A4;
            margin: 0;
            background-color: #ffffff;
        }
        *, *::before, *::after {
            box-sizing: border-box;
        }
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #2c3e50;
            margin: 0;
            padding: 0;
            font-size: 10pt;
            line-height: 1.4;
            background-color: #ffffff;
        }

        .top-accent-bar {
            height: 10px;
            background: linear-gradient(90deg, #6b21a8, #9333ea, #c084fc);
            width: 100%;
        }

        .container {
            padding: 30px 40px;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }
        .header-table td {
            vertical-align: top;
        }
        .brand-logo-text {
            font-size: 24pt;
            font-weight: 800;
            color: #6b21a8;
            letter-spacing: -0.5px;
            margin: 0;
            line-height: 1;
        }
        .brand-subtext {
            font-size: 9pt;
            color: #9333ea;
            font-weight: 600;
            letter-spacing: 2px;
            margin-top: 3px;
        }
        .invoice-title {
            text-align: right;
        }
        .invoice-title h1 {
            margin: 0;
            font-size: 20pt;
            color: #1e293b;
            font-weight: 700;
            letter-spacing: 1px;
        }
        .meta-pill {
            display: inline-block;
            background-color: #f3e8ff;
            color: #6b21a8;
            padding: 4px 10px;
            border-radius: 4px;
            font-weight: 600;
            font-size: 9pt;
            margin-top: 6px;
        }

        .details-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 15px 0;
            margin-left: -15px;
            margin-right: -15px;
            margin-bottom: 25px;
        }
        .details-cell {
            width: 50%;
            vertical-align: top;
            background-color: #faf5ff;
            border: 1px solid #e9d5ff;
            border-radius: 8px;
            padding: 16px;
        }
        .section-title {
            font-size: 9pt;
            font-weight: 700;
            text-transform: uppercase;
            color: #6b21a8;
            letter-spacing: 0.8px;
            margin-bottom: 8px;
            border-bottom: 1px solid #e9d5ff;
            padding-bottom: 4px;
        }
        .entity-name {
            font-size: 11pt;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 4px;
        }
        .info-line {
            margin: 2px 0;
            color: #475569;
            font-size: 9.5pt;
        }
        .gstin-badge {
            margin-top: 8px;
            padding-top: 6px;
            border-top: 1px dashed #d8b4fe;
            font-weight: 600;
            color: #581c87;
        }

        .invoice-info-bar {
            width: 100%;
            border-collapse: collapse;
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            margin-bottom: 25px;
        }
        .invoice-info-bar td {
            padding: 10px 14px;
            font-size: 9pt;
            border-right: 1px solid #e2e8f0;
        }
        .invoice-info-bar td:last-child {
            border-right: none;
        }
        .info-label {
            color: #64748b;
            text-transform: uppercase;
            font-size: 7.5pt;
            font-weight: 700;
            display: block;
            margin-bottom: 2px;
        }
        .info-val {
            color: #0f172a;
            font-weight: 600;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        .items-table th {
            background-color: #6b21a8;
            color: #ffffff;
            font-weight: 600;
            text-align: left;
            padding: 10px 12px;
            font-size: 9pt;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .items-table th.text-right, .items-table td.text-right {
            text-align: right;
        }
        .items-table td {
            padding: 12px;
            border-bottom: 1px solid #e2e8f0;
            vertical-align: top;
        }
        .item-name {
            font-weight: 700;
            color: #1e293b;
            font-size: 10pt;
        }
        .item-desc {
            color: #64748b;
            font-size: 8.5pt;
            margin-top: 4px;
        }
        .feature-tag {
            display: inline-block;
            background-color: #f1f5f9;
            color: #475569;
            font-size: 7.5pt;
            padding: 2px 6px;
            border-radius: 3px;
            margin-right: 4px;
            margin-top: 4px;
        }

        .totals-container {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        .totals-container td {
            vertical-align: top;
        }
        .notes-cell {
            width: 55%;
            padding-right: 20px;
        }
        .summary-cell {
            width: 45%;
        }

        .bank-details-box {
            background-color: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 12px;
            font-size: 8.5pt;
        }
        .bank-details-box h5 {
            margin: 0 0 6px 0;
            color: #334155;
            font-size: 9pt;
            font-weight: 700;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }
        .summary-table td {
            padding: 6px 10px;
            font-size: 9.5pt;
        }
        .summary-table .label {
            color: #64748b;
        }
        .summary-table .value {
            text-align: right;
            font-weight: 600;
            color: #1e293b;
        }
        .summary-table tr.total-row td {
            border-top: 2px solid #6b21a8;
            border-bottom: 2px solid #6b21a8;
            background-color: #faf5ff;
            padding: 10px;
        }
        .summary-table tr.total-row .label {
            color: #581c87;
            font-weight: 700;
            font-size: 11pt;
        }
        .summary-table tr.total-row .value {
            color: #6b21a8;
            font-weight: 800;
            font-size: 12pt;
        }

        .signature-section {
            margin-top: 40px;
            width: 100%;
            border-collapse: collapse;
        }
        .signature-section td {
            width: 50%;
            vertical-align: bottom;
        }
        .signature-box {
            text-align: right;
        }
        .sig-line {
            border-top: 1px solid #94a3b8;
            width: 180px;
            margin-left: auto;
            margin-top: 40px;
            margin-bottom: 4px;
        }
        .sig-name {
            font-weight: 700;
            color: #1e293b;
            font-size: 9.5pt;
        }
        .sig-title {
            color: #64748b;
            font-size: 8.5pt;
        }

        .footer-banner {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background-color: #f8fafc;
            border-top: 1px solid #e2e8f0;
            padding: 15px 40px;
            text-align: center;
            font-size: 8.5pt;
            color: #64748b;
        }
    </style>
</head>
<body>

    <div class="top-accent-bar"></div>

    <div class="container">
        <!-- Header -->
        <table class="header-table">
            <tr>
                <td>
                    <div class="brand-logo-text"><%= vendor.name %></div>
                    <div class="brand-subtext"><%= vendor.subtext %></div>
                </td>
                <td class="invoice-title">
                    <h1>TAX INVOICE</h1>
                    <span class="meta-pill">ORIGINAL FOR RECIPIENT</span>
                </td>
            </tr>
        </table>

        <!-- Invoice Details Strip -->
        <table class="invoice-info-bar">
            <tr>
                <td>
                    <span class="info-label">Invoice Number</span>
                    <span class="info-val"><%= invoice.number %></span>
                </td>
                <td>
                    <span class="info-label">Invoice Date</span>
                    <span class="info-val"><%= invoice.date %></span>
                </td>
                <td>
                    <span class="info-label">Place of Supply</span>
                    <span class="info-val"><%= invoice.placeOfSupply %></span>
                </td>
                <td>
                    <span class="info-label">Payment Terms</span>
                    <span class="info-val"><%= invoice.paymentTerms %></span>
                </td>
            </tr>
        </table>

        <!-- Vendor & Customer Details -->
        <table class="details-table">
            <tr>
                <td class="details-cell">
                    <div class="section-title">Billed By (Vendor / Service Provider)</div>
                    <div class="entity-name"><%= vendor.name %></div>
                    <div class="info-line"><%= vendor.addressLine1 %></div>
                    <div class="info-line"><%= vendor.addressLine2 %></div>
                    <div class="info-line">Email: <%= vendor.email %> | Mob: <%= vendor.phone %></div>
                    <div class="info-line gstin-badge">GSTIN: <%= vendor.gstin %></div>
                    <div class="info-line">PAN: <%= vendor.pan %></div>
                </td>
                <td class="details-cell">
                    <div class="section-title">Billed To (Customer Details)</div>
                    <div class="entity-name"><%= customer.name %></div>
                    <div class="info-line"><%= customer.addressLine1 %></div>
                    <div class="info-line"><%= customer.addressLine2 %></div>
                    <div class="info-line">Contact Person: <%= customer.contactPerson %> (<%= customer.phone %>)</div>
                    <div class="info-line gstin-badge">GSTIN: <%= customer.gstin %></div>
                    <div class="info-line">State Code: <%= customer.stateCode %></div>
                </td>
            </tr>
        </table>

        <!-- Product / Service Details Table -->
        <table class="items-table">
            <thead>
                <tr>
                    <th style="width: 5%;">#</th>
                    <th style="width: 45%;">Description of Service</th>
                    <th style="width: 12%;">HSN / SAC</th>
                    <th style="width: 12%;" class="text-right">Rate (₹)</th>
                    <th style="width: 8%;" class="text-right">Qty</th>
                    <th style="width: 18%;" class="text-right">Taxable Value (₹)</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach((item, index) => { %>
                    <tr>
                        <td><%= index + 1 %></td>
                        <td>
                            <div class="item-name"><%= item.name %></div>
                            <div class="item-desc"><%= item.description %></div>
                            <% if (item.features && item.features.length > 0) { %>
                                <div style="margin-top: 4px;">
                                    <% item.features.forEach(feature => { %>
                                        <span class="feature-tag">✔ <%= feature %></span>
                                    <% }) %>
                                </div>
                            <% } %>
                        </td>
                        <td><%= item.hsnSac %></td>
                        <td class="text-right"><%= item.rate.toFixed(2) %></td>
                        <td class="text-right"><%= item.qty %></td>
                        <td class="text-right"><%= (item.rate * item.qty).toFixed(2) %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- Summary & Totals -->
        <table class="totals-container">
            <tr>
                <td class="notes-cell">
                    <div class="bank-details-box">
                        <h5>Bank & Payment Details</h5>
                        <div class="info-line"><strong>Bank Name:</strong> <%= bank.name %></div>
                        <div class="info-line"><strong>Account Name:</strong> <%= bank.accountName %></div>
                        <div class="info-line"><strong>Account No:</strong> <%= bank.accountNo %></div>
                        <div class="info-line"><strong>IFSC Code:</strong> <%= bank.ifsc %></div>
                        <div class="info-line"><strong>Branch:</strong> <%= bank.branch %></div>
                    </div>
                    <p style="font-size: 8pt; color: #64748b; margin-top: 10px;">
                        <strong>Amount in Words:</strong> <%= totals.amountInWords %>
                    </p>
                </td>
                <td class="summary-cell">
                    <table class="summary-table">
                        <tr>
                            <td class="label">Taxable Amount</td>
                            <td class="value">₹<%= totals.taxableAmount.toFixed(2) %></td>
                        </tr>
                        <tr>
                            <td class="label">CGST @ <%= totals.cgstRate %>%</td>
                            <td class="value">₹<%= totals.cgstAmount.toFixed(2) %></td>
                        </tr>
                        <tr>
                            <td class="label">SGST @ <%= totals.sgstRate %>%</td>
                            <td class="value">₹<%= totals.sgstAmount.toFixed(2) %></td>
                        </tr>
                        <tr>
                            <td class="label">IGST @ <%= totals.igstRate %>%</td>
                            <td class="value">₹<%= totals.igstAmount.toFixed(2) %></td>
                        </tr>
                        <tr class="total-row">
                            <td class="label">Total Amount</td>
                            <td class="value">₹<%= totals.grandTotal.toFixed(2) %></td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>

        <!-- Signatures -->
        <table class="signature-section">
            <tr>
                <td>
                    <div style="font-size: 8.5pt; color: #64748b;">
                        <strong>Terms & Conditions:</strong><br>
                        1. Payment is non-refundable once service activation starts.<br>
                        2. Subject to <%= vendor.city %>, <%= vendor.state %> jurisdiction.
                    </div>
                </td>
                <td>
                    <div class="signature-box">
                        <div style="font-size: 8.5pt; font-weight: 700; color: #334155;">For <%= vendor.name %></div>
                        <div class="sig-line"></div>
                        <div class="sig-name"><%= vendor.signatoryName %></div>
                        <div class="sig-title"><%= vendor.signatoryTitle %></div>
                    </div>
                </td>
            </tr>
        </table>
    </div>

    <!-- Footer -->
    <div class="footer-banner">
        Thank you for your business! | <%= vendor.name %> - <%= vendor.addressLine1 %>, <%= vendor.addressLine2 %>
    </div>

</body>
</html>
