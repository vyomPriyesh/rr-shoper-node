<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tax Invoice - <%= invoice.number %></title>

    <style>
        :root {
            --primary: #B06A8D;
            --primary-dark: #9A5A7C;
            --secondary: #C89AB5;
            --background: #F8F1F5;
            --border: #E8DDE3;
            --heading: #1E1E1E;
            --paragraph: #5F6673;
            --white: #FFFFFF;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: #eeeeee;
            color: var(--paragraph);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
        }

        body {
            padding: 20px 0;
        }

        .invoice-page {
            position: relative;
            width: 210mm;
            height: 297mm;
            min-height: 297mm;
            margin: 0 auto;
            padding: 0 10mm;
            overflow: hidden;
            background: var(--white);
        }

        .top-accent {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: var(--primary);
        }

        .header {
            display: table;
            width: 100%;
            padding-top: 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid var(--border);
            table-layout: fixed;
        }

        .header-left,
        .header-right {
            display: table-cell;
            vertical-align: middle;
        }

        .header-left {
            width: 60%;
        }

        .header-right {
            width: 40%;
            text-align: right;
        }

        .brand-name {
            margin: 0;
            color: var(--primary);
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.4px;
        }

        .brand-subtext {
            margin-top: 5px;
            color: var(--paragraph);
            font-size: 12px;
        }

        .invoice-heading {
            margin: 0;
            color: var(--heading);
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.8px;
        }

        .invoice-label {
            margin-top: 5px;
            color: var(--primary);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .invoice-meta {
            width: 100%;
            margin-top: 12px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: var(--background);
            overflow: hidden;
        }

        .invoice-meta-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .invoice-meta-table td {
            width: 25%;
            padding: 10px 12px;
            border-right: 1px solid var(--border);
            vertical-align: top;
        }

        .invoice-meta-table td:last-child {
            border-right: none;
        }

        .meta-label {
            margin-bottom: 5px;
            color: var(--paragraph);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .meta-value {
            color: var(--heading);
            font-size: 12px;
            font-weight: 700;
        }

        .party-table {
            width: 100%;
            margin: 15px 0 20px;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .party-table > tbody > tr {
            height: 178px;
        }

        .party-table > tbody > tr > td {
            width: 50%;
            height: 178px;
            padding: 0;
            vertical-align: top;
        }

        .party-table > tbody > tr > td:first-child {
            padding-right: 6px;
        }

        .party-table > tbody > tr > td:last-child {
            padding-left: 6px;
        }

        .party-card {
            display: flex;
            flex-direction: column;
            width: 100%;
            height: 178px;
            min-height: 178px;
            padding: 15px 16px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: var(--white);
        }

        .vendor-card {
            border-top: 3px solid var(--primary);
        }

        .customer-card {
            border-top: 3px solid var(--secondary);
        }

        .party-title {
            margin-bottom: 8px;
            color: var(--primary);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .customer-card .party-title {
            color: var(--secondary);
        }

        .party-name {
            margin-bottom: 6px;
            color: var(--heading);
            font-size: 15px;
            font-weight: 700;
        }

        .party-line {
            margin-bottom: 5px;
            color: var(--paragraph);
            font-size: 12px;
            line-height: 1.5;
        }

        .party-line strong {
            color: var(--heading);
            font-weight: 700;
        }

        .gst-row {
            margin-top: auto;
            padding-top: 10px;
            border-top: 1px dashed var(--border);
            color: var(--primary);
            font-size: 12px;
            font-weight: 700;
            line-height: 1.4;
            white-space: nowrap;
        }

        .customer-card .gst-row {
            color: var(--primary-dark);
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            border: 1px solid var(--border);
            border-radius: 7px;
            overflow: hidden;
        }

        .items-table thead th {
            padding: 10px 8px;
            background: var(--primary);
            color: var(--white);
            font-size: 10px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: 0.25px;
            border-right: 1px solid rgba(255, 255, 255, 0.25);
        }

        .items-table thead th:last-child {
            border-right: none;
        }

        .items-table tbody td {
            padding: 10px 8px;
            color: var(--paragraph);
            font-size: 11.5px;
            line-height: 1.45;
            border-top: 1px solid var(--border);
            border-right: 1px solid var(--border);
            vertical-align: top;
        }

        .items-table tbody td:last-child {
            border-right: none;
        }

        .items-table tbody tr:nth-child(even) td {
            background: #FCF9FB;
        }

        .item-name {
            color: var(--heading);
            font-size: 12px;
            font-weight: 700;
        }

        .item-description {
            margin-top: 3px;
            color: var(--paragraph);
            font-size: 10px;
            line-height: 1.45;
        }

        .text-center {
            text-align: center !important;
        }

        .text-right {
            text-align: right !important;
        }

        .col-no {
            width: 5%;
        }

        .col-item {
            width: 37%;
        }

        .col-hsn {
            width: 12%;
        }

        .col-rate {
            width: 13%;
        }

        .col-qty {
            width: 8%;
        }

        .col-total {
            width: 25%;
        }

        .total-section {
            display: table;
            width: 100%;
            margin-top: 14px;
            table-layout: fixed;
        }

        .amount-words-wrapper {
            display: table-cell;
            width: 54%;
            padding-right: 7px;
            vertical-align: top;
        }

        .summary-wrapper {
            display: table-cell;
            width: 46%;
            padding-left: 7px;
            vertical-align: top;
        }

        .amount-words {
            min-height: 86px;
            padding: 13px 14px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--background);
        }

        .section-label {
            margin-bottom: 7px;
            color: var(--primary);
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .amount-value {
            color: var(--heading);
            font-size: 12px;
            font-weight: 600;
            line-height: 1.5;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid var(--border);
            border-radius: 8px;
            overflow: hidden;
        }

        .summary-table td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--border);
            font-size: 11.5px;
        }

        .summary-table tr:last-child td {
            border-bottom: none;
        }

        .summary-label {
            color: var(--paragraph);
        }

        .summary-value {
            color: var(--heading);
            font-weight: 700;
            text-align: right;
        }

        .grand-total td {
            padding-top: 10px;
            padding-bottom: 10px;
            background: var(--primary);
            color: var(--white) !important;
            font-size: 13px !important;
            font-weight: 800 !important;
        }

        .bottom-section {
            position: absolute;
            right: 10mm;
            bottom: 54px;
            left: 10mm;
        }

        .bottom-divider {
            width: 100%;
            height: 1px;
            margin-bottom: 12px;
            background: var(--border);
        }

        .terms-signature-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .terms-signature-table > tbody > tr > td {
            width: 50%;
            vertical-align: top;
        }

        .terms-cell {
            padding-right: 20px;
        }

        .signature-cell {
            padding-left: 20px;
            text-align: right;
        }

        .terms-title,
        .signature-title-main {
            margin-bottom: 7px;
            color: var(--heading);
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.35px;
        }

        .terms-list {
            margin: 0;
            padding-left: 15px;
            color: var(--paragraph);
            font-size: 10px;
            line-height: 1.5;
        }

        .terms-list li {
            margin-bottom: 3px;
        }

        .signature {
            display: inline-block;
            min-width: 150px;
            text-align: center;
        }

        .signature-for {
            margin-bottom: 4px;
            color: var(--paragraph);
            font-size: 11px;
            text-align: center;
        }

        .signature-image-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 42px;
            margin-bottom: 2px;
        }

        .signature-image {
            display: block;
            max-width: 120px;
            max-height: 40px;
            object-fit: contain;
        }

        .signature-placeholder {
            height: 42px;
        }

        .signature-line {
            width: 150px;
            height: 1px;
            margin: 0 auto 5px;
            background: var(--heading);
        }

        .signature-name {
            color: var(--heading);
            font-size: 11.5px;
            font-weight: 700;
        }

        .signature-title {
            margin-top: 2px;
            color: var(--paragraph);
            font-size: 10px;
        }

        .page-footer {
            position: absolute;
            right: 10mm;
            bottom: 0;
            left: 10mm;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-top: 1px solid var(--border);
            color: var(--paragraph);
            font-size: 10px;
        }

        .footer-left {
            max-width: 70%;
            text-align: left;
        }

        .footer-right {
            color: var(--primary);
            font-weight: 700;
            text-align: right;
        }

        @media print {

            @page {
                size: A4;
                margin: 0;
            }

            html,
            body {
                width: 210mm;
                height: 297mm;
                margin: 0;
                padding: 0;
                background: var(--white);
            }

            body {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .invoice-page {
                width: 210mm;
                height: 297mm;
                min-height: 297mm;
                margin: 0;
                padding: 0 10mm;
                overflow: hidden;
            }

            .top-accent {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .party-table > tbody > tr {
                height: 178px;
            }

            .party-table > tbody > tr > td {
                height: 178px;
            }

            .party-card {
                height: 178px;
                min-height: 178px;
            }

            .items-table {
                page-break-inside: avoid;
            }

            .total-section {
                page-break-inside: avoid;
            }

            .bottom-section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>

<body>

    <div class="invoice-page">

        <div class="top-accent"></div>

        <div class="header">

            <div class="header-left">

                <div class="brand-name">
                    <%= vendor.name %>
                </div>

                <% if (vendor.subtext) { %>
                    <div class="brand-subtext">
                        <%= vendor.subtext %>
                    </div>
                <% } %>

            </div>

            <div class="header-right">

                <div class="invoice-heading">
                    TAX INVOICE
                </div>

                <div class="invoice-label">
                    Original for Recipient
                </div>

            </div>

        </div>

        <div class="invoice-meta">

            <table class="invoice-meta-table">

                <tbody>

                    <tr>

                        <td>
                            <div class="meta-label">
                                Invoice Number
                            </div>

                            <div class="meta-value">
                                <%= invoice.number %>
                            </div>
                        </td>

                        <td>
                            <div class="meta-label">
                                Invoice Date
                            </div>

                            <div class="meta-value">
                                <%= invoice.date %>
                            </div>
                        </td>

                        <td>
                            <div class="meta-label">
                                Place of Supply
                            </div>

                            <div class="meta-value">
                                <%= invoice.placeOfSupply %>
                            </div>
                        </td>

                        <td>
                            <div class="meta-label">
                                Payment Terms
                            </div>

                            <div class="meta-value">
                                <%= invoice.paymentTerms %>
                            </div>
                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <table class="party-table">

            <tbody>

                <tr>

                    <td>

                        <div class="party-card vendor-card">

                            <div class="party-title">
                                Billed By / Service Provider
                            </div>

                            <div class="party-name">
                                <%= vendor.name %>
                            </div>

                            <div class="party-line">
                                <%= vendor.address %>
                            </div>

                            <div class="party-line">

                                <strong>Email:</strong>
                                <%= vendor.email %>

                                &nbsp;&nbsp;|&nbsp;&nbsp;

                                <strong>Mob:</strong>
                                <%= vendor.phone %>

                            </div>

                            <div class="gst-row">
                                GSTIN: <%= vendor.gstin %>
                            </div>

                        </div>

                    </td>

                    <td>

                        <div class="party-card customer-card">

                            <div class="party-title">
                                Billed To / Customer Details
                            </div>

                            <div class="party-name">
                                <%= customer.name %>
                            </div>

                            <div class="party-line">
                                <%= customer.address %>
                            </div>

                            <div class="party-line">

                                <strong>Contact:</strong>
                                <%= customer.contactPerson %>

                                &nbsp;(<%= customer.phone %>)

                            </div>

                            <div class="gst-row">
                                GSTIN: <%= customer.gstin %>
                            </div>

                        </div>

                    </td>

                </tr>

            </tbody>

        </table>

        <table class="items-table">

            <thead>

                <tr>

                    <th class="col-no text-center">
                        #
                    </th>

                    <th class="col-item">
                        Item / Description
                    </th>

                    <th class="col-hsn text-center">
                        HSN/SAC
                    </th>

                    <th class="col-rate text-right">
                        Rate
                    </th>

                    <th class="col-qty text-center">
                        Qty
                    </th>

                    <th class="col-total text-right">
                        Amount
                    </th>

                </tr>

            </thead>

            <tbody>

                <% items.forEach((item, index) => { %>

                    <tr>

                        <td class="text-center">
                            <%= index + 1 %>
                        </td>

                        <td>

                            <div class="item-name">
                                <%= item.name %>
                            </div>

                            <% if (item.description) { %>

                                <div class="item-description">
                                    <%= item.description %>
                                </div>

                            <% } %>

                        </td>

                        <td class="text-center">
                            <%= item.hsnSac %>
                        </td>

                        <td class="text-right">
                            ₹ <%= Number(item.rate || 0).toFixed(2) %>
                        </td>

                        <td class="text-center">
                            <%= item.qty %>
                        </td>

                        <td class="text-right">
                            ₹ <%= (Number(item.rate || 0) * Number(item.qty || 0)).toFixed(2) %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

        <div class="total-section">

            <!-- <div class="amount-words-wrapper">

                <div class="amount-words">

                    <div class="section-label">
                        Amount in Words
                    </div>

                    <div class="amount-value">
                        <%= totals.amountInWords %>
                    </div>

                </div>

            </div> --> 

            <div class="summary-wrapper">

                <table class="summary-table">

                    <tbody>

                        <tr>

                            <td class="summary-label">
                                Taxable Amount
                            </td>

                            <td class="summary-value">
                                ₹ <%= Number(totals.taxableAmount || 0).toFixed(2) %>
                            </td>

                        </tr>

                        <% if (Number(totals.cgstAmount || 0) > 0) { %>

                            <tr>

                                <td class="summary-label">
                                    CGST (<%= totals.cgstRate %>%)
                                </td>

                                <td class="summary-value">
                                    ₹ <%= Number(totals.cgstAmount || 0).toFixed(2) %>
                                </td>

                            </tr>

                        <% } %>

                        <% if (Number(totals.sgstAmount || 0) > 0) { %>

                            <tr>

                                <td class="summary-label">
                                    SGST (<%= totals.sgstRate %>%)
                                </td>

                                <td class="summary-value">
                                    ₹ <%= Number(totals.sgstAmount || 0).toFixed(2) %>
                                </td>

                            </tr>

                        <% } %>

                        <% if (Number(totals.igstAmount || 0) > 0) { %>

                            <tr>

                                <td class="summary-label">
                                    IGST (<%= totals.igstRate %>%)
                                </td>

                                <td class="summary-value">
                                    ₹ <%= Number(totals.igstAmount || 0).toFixed(2) %>
                                </td>

                            </tr>

                        <% } %>

                        <tr class="grand-total">

                            <td>
                                Grand Total
                            </td>

                            <td class="text-right">
                                ₹ <%= Number(totals.grandTotal || 0).toFixed(2) %>
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

        <div class="bottom-section">

            <div class="bottom-divider"></div>

            <table class="terms-signature-table">

                <tbody>

                    <tr>

                        <td class="terms-cell">

                            <div class="terms-title">
                                Terms & Conditions
                            </div>

                            <ul class="terms-list">

                                <li>
                                    Goods/services once sold are not returnable unless otherwise agreed.
                                </li>

                                <li>
                                    Payment is due according to the agreed payment terms.
                                </li>

                                <li>
                                    Any applicable taxes are included as mentioned in this invoice.
                                </li>

                                <li>
                                    Subject to the jurisdiction mentioned on the invoice.
                                </li>

                            </ul>

                        </td>

                        <td class="signature-cell">

                            <div class="signature-title-main">
                                Authorized Signatory
                            </div>

                            <div class="signature">

                                <div class="signature-for">
                                    For <%= vendor.name %>
                                </div>

                                <% if (vendor.signature) { %>

                                    <div class="signature-image-wrapper">

                                        <img
                                            src="<%= vendor.signature %>"
                                            alt="Authorized Signature"
                                            class="signature-image"
                                        >

                                    </div>

                                <% } else { %>

                                    <div class="signature-placeholder"></div>

                                <% } %>

                                <div class="signature-line"></div>

                                <div class="signature-name">
                                    <%= vendor.signatoryName %>
                                </div>

                                <div class="signature-title">
                                    <%= vendor.signatoryTitle %>
                                </div>

                            </div>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <div class="page-footer">

            <div class="footer-left">

                <%= vendor.addressLine1 %>

                <% if (vendor.addressLine2) { %>
                    , <%= vendor.addressLine2 %>
                <% } %>

                <% if (vendor.city) { %>
                    , <%= vendor.city %>
                <% } %>

                <% if (vendor.state) { %>
                    , <%= vendor.state %>
                <% } %>

            </div>

            <div class="footer-right">
                Thank you for your business
            </div>

        </div>

    </div>

</body>

</html>