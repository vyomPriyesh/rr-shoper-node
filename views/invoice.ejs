<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Tax Invoice - <%= invoice.number %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            background: #FFFFFF;
            color: #5F6673;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 10px;
        }

        .top-accent {
            width: 100%;
            height: 3px;
            background-color: #B06A8D;
            margin-bottom: 6px;
        }

        .header {
            display: table;
            width: 100%;
            padding-bottom: 6px;
            border-bottom: 1px solid #E8DDE3;
            table-layout: fixed;
        }

        .header-left {
            display: table-cell;
            width: 55%;
            vertical-align: middle;
        }

        .header-right {
            display: table-cell;
            width: 45%;
            text-align: right;
            vertical-align: middle;
        }

        .brand-name {
            margin: 0;
            color: #B06A8D;
            font-size: 18px;
            font-weight: 800;
        }

        .brand-subtext {
            margin-top: 2px;
            color: #5F6673;
            font-size: 9px;
        }

        .invoice-heading {
            margin: 0;
            color: #1E1E1E;
            font-size: 18px;
            font-weight: 800;
        }

        .invoice-label {
            margin-top: 2px;
            color: #B06A8D;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .invoice-meta {
            width: 100%;
            margin-top: 6px;
            border: 1px solid #E8DDE3;
            border-radius: 4px;
            background-color: #F8F1F5;
        }

        .invoice-meta-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .invoice-meta-table td {
            width: 25%;
            padding: 4px 6px;
            border-right: 1px solid #E8DDE3;
            vertical-align: top;
        }

        .invoice-meta-table td:last-child {
            border-right: none;
        }

        .meta-label {
            margin-bottom: 2px;
            color: #5F6673;
            font-size: 7.5px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .meta-value {
            color: #1E1E1E;
            font-size: 9.5px;
            font-weight: 700;
        }

        .party-table {
            width: 100%;
            margin: 6px 0;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .party-table > tbody > tr > td {
            width: 50%;
            vertical-align: top;
        }

        .party-table > tbody > tr > td:first-child { padding-right: 4px; }
        .party-table > tbody > tr > td:last-child { padding-left: 4px; }

        .party-card {
            width: 100%;
            padding: 6px 8px;
            border: 1px solid #E8DDE3;
            border-radius: 4px;
            background-color: #FFFFFF;
        }

        .vendor-card { border-top: 3px solid #B06A8D; }
        .customer-card { border-top: 3px solid #B06A8D; }

        .party-title {
            color: #B06A8D;
            font-size: 8.5px;
            font-weight: 800;
            text-transform: uppercase;
            padding-bottom: 2px;
        }

        .customer-card .party-title { color: #B06A8D; }

        .party-name {
            color: #1E1E1E;
            font-size: 11px;
            font-weight: 700;
            padding-bottom: 2px;
        }

        .party-line {
            color: #5F6673;
            font-size: 9px;
            line-height: 1.3;
        }

        .gst-row {
            margin-top: 4px;
            padding-top: 3px;
            border-top: 1px dashed #E8DDE3;
            color: #B06A8D;
            font-size: 9px;
            font-weight: 700;
        }

        .customer-card .gst-row { color: #9A5A7C; }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            border: 1px solid #E8DDE3;
            border-radius: 4px;
            margin-top: 4px;
        }

        .items-table thead th {
            padding: 5px;
            background-color: #B06A8D;
            color: #FFFFFF;
            font-size: 8.5px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            border-right: 1px solid rgba(255, 255, 255, 0.25);
        }

        .items-table thead th:last-child { border-right: none; }

        .items-table tbody td {
            padding: 5px;
            color: #5F6673;
            font-size: 9.5px;
            border-top: 1px solid #E8DDE3;
            border-right: 1px solid #E8DDE3;
            vertical-align: top;
        }

        .items-table tbody td:last-child { border-right: none; }

        .item-name { color: #1E1E1E; font-weight: 700; }
        .item-description { margin-top: 2px; color: #5F6673; font-size: 8px; }

        .text-center { text-align: center !important; }
        .text-right { text-align: right !important; }

        .col-no { width: 6%; }
        .col-item { width: 38%; }
        .col-hsn { width: 14%; }
        .col-rate { width: 14%; }
        .col-qty { width: 8%; }
        .col-total { width: 20%; }

        .total-section {
            display: table;
            width: 100%;
            margin-top: 6px;
            table-layout: fixed;
        }

        .amount-words-wrapper {
            display: table-cell;
            width: 50%;
            padding-right: 4px;
            vertical-align: top;
        }

        .summary-wrapper {
            display: table-cell;
            width: 50%;
            vertical-align: top;
        }

        .amount-words {
            padding: 6px;
            border: 1px solid #E8DDE3;
            border-radius: 4px;
            background-color: #F8F1F5;
        }

        .section-label {
            margin-bottom: 2px;
            color: #B06A8D;
            font-size: 7.5px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .amount-value {
            color: #1E1E1E;
            font-size: 9.5px;
            font-weight: 600;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #E8DDE3;
            border-radius: 4px;
        }

        .summary-table td {
            padding: 3px 6px;
            border-bottom: 1px solid #E8DDE3;
            font-size: 9.5px;
        }

        .summary-table tr:last-child td { border-bottom: none; }
        .summary-label { color: #5F6673; }
        .summary-value { color: #1E1E1E; font-weight: 700; text-align: right; }

        .grand-total td {
            background-color: #B06A8D;
            color: #FFFFFF !important;
            font-size: 10.5px !important;
            font-weight: 800 !important;
        }

        /* Fixed Footer Container with explicit spacing */
        #pageFooter {
            width: 100%;
            padding-top: 4px;
            border-top: 1px solid #E8DDE3;
            font-family: Arial, Helvetica, sans-serif;
            box-sizing: border-box;
        }

        .terms-signature-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .terms-signature-table td {
            vertical-align: bottom;
        }

        .terms-cell { width: 55%; padding-right: 10px; }
        .signature-cell { width: 45%; text-align: right; }

        .terms-title {
            margin-bottom: 2px;
            color: #1E1E1E;
            font-size: 8.5px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .terms-list {
            margin: 0;
            padding-left: 12px;
            color: #5F6673;
            font-size: 8px;
            line-height: 1.2;
        }

        .signature {
            display: inline-block;
            text-align: center;
        }

        .signature-for {
            margin-bottom: 2px;
            color: #5F6673;
            font-size: 8.5px;
        }

        .signature-line {
            width: 120px;
            height: 1px;
            margin: 14px auto 2px;
            background-color: #1E1E1E;
        }

        .signature-name { color: #1E1E1E; font-size: 9.5px; font-weight: 700; }
        .signature-title { color: #5F6673; font-size: 8px; }

        .page-footer-table {
            width: 100%;
            margin-top: 4px;
            border-collapse: collapse;
            color: #5F6673;
            font-size: 8px;
        }

        .footer-left { text-align: left; width: 70%; }
        .footer-right { color: #B06A8D; font-weight: 700; text-align: right; width: 30%; }
    </style>
</head>

<body>

    <div class="top-accent"></div>

    <div class="header">
        <div class="header-left">
            <div class="brand-name"><%= vendor.name %></div>
            <% if (vendor.subtext) { %>
                <div class="brand-subtext"><%= vendor.subtext %></div>
            <% } %>
        </div>
        <div class="header-right">
            <div class="invoice-heading">TAX INVOICE</div>
            <div class="invoice-label">Original for Recipient</div>
        </div>
    </div>

    <div class="invoice-meta">
        <table class="invoice-meta-table">
            <tbody>
                <tr>
                    <td>
                        <div class="meta-label">Invoice Number</div>
                        <div class="meta-value"><%= invoice.number %></div>
                    </td>
                    <td>
                        <div class="meta-label">Invoice Date</div>
                        <div class="meta-value"><%= invoice.date %></div>
                    </td>
                    <td>
                        <div class="meta-label">Place of Supply</div>
                        <div class="meta-value"><%= invoice.placeOfSupply %></div>
                    </td>
                    <td>
                        <div class="meta-label">Payment Terms</div>
                        <div class="meta-value"><%= invoice.paymentTerms %></div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <table class="party-table">
        <tbody>
            <tr>
                <td>
                    <div class="party-card vendor-card">
                        <div class="party-title">Billed By / Service Provider</div>
                        <div class="party-name"><%= vendor.name %></div>
                        <div class="party-line"><%= vendor.address %></div>
                        <div class="party-line">
                            <strong>Email:</strong> <%= vendor.email %> &nbsp;|&nbsp; <strong>Mob:</strong> <%= vendor.phone %>
                        </div>
                        <div class="gst-row">GSTIN: <%= vendor.gstin %></div>
                    </div>
                </td>
                <td>
                    <div class="party-card customer-card">
                        <div class="party-title">Billed To / Customer Details</div>
                        <div class="party-name"><%= customer.name %></div>
                        <div class="party-line"><%= customer.address %></div>
                        <div class="party-line">
                            <strong>Contact:</strong> <%= customer.contactPerson %> (<%= customer.phone %>)
                        </div>
                        <div class="gst-row">GSTIN: <%= customer.gstin %></div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>

    <table class="items-table">
        <thead>
            <tr>
                <th class="col-no text-center">#</th>
                <th class="col-item">Item / Description</th>
                <th class="col-hsn text-center">HSN/SAC</th>
                <th class="col-rate text-right">Rate</th>
                <th class="col-qty text-center">Qty</th>
                <th class="col-total text-right">Amount</th>
            </tr>
        </thead>
        <tbody>
            <% items.forEach((item, index) => { %>
                <tr>
                    <td class="text-center"><%= index + 1 %></td>
                    <td>
                        <div class="item-name"><%= item.name %></div>
                        <% if (item.description) { %>
                            <div class="item-description"><%= item.description %></div>
                        <% } %>
                    </td>
                    <td class="text-center"><%= item.hsnSac %></td>
                    <td class="text-right"><%= item.rate.toFixed(2) %></td>
                    <td class="text-center"><%= item.qty %></td>
                    <td class="text-right"><%= (item.rate * item.qty).toFixed(2) %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <div class="total-section">
        
        <div class="summary-wrapper">
            <table class="summary-table">
                <tbody>
                    <tr>
                        <td class="summary-label">Taxable Amount</td>
                        <td class="summary-value"><%= totals.taxableAmount.toFixed(2) %></td>
                    </tr>
                    <% if (totals.cgstAmount > 0) { %>
                        <tr>
                            <td class="summary-label">CGST (<%= totals.cgstRate %>%)</td>
                            <td class="summary-value"><%= totals.cgstAmount.toFixed(2) %></td>
                        </tr>
                    <% } %>
                    <% if (totals.sgstAmount > 0) { %>
                        <tr>
                            <td class="summary-label">SGST (<%= totals.sgstRate %>%)</td>
                            <td class="summary-value"><%= totals.sgstAmount.toFixed(2) %></td>
                        </tr>
                    <% } %>
                    <% if (totals.igstAmount > 0) { %>
                        <tr>
                            <td class="summary-label">IGST (<%= totals.igstRate %>%)</td>
                            <td class="summary-value"><%= totals.igstAmount.toFixed(2) %></td>
                        </tr>
                    <% } %>
                    <tr class="grand-total">
                        <td>Grand Total</td>
                        <td class="text-right"><%= totals.grandTotal.toFixed(2) %></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
