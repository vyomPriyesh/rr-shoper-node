<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tax Invoice - <%= invoice.number %></title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            background: #FFFFFF;
            color: #5F6673;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 13px;
        }

        .invoice-page {
            position: relative;
            width: 210mm;
            height: 297mm;
            margin: 0 auto;
            padding: 0 10mm;
            background: #FFFFFF;
        }

        .top-accent {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background-color: #B06A8D;
        }

        .header {
            display: table;
            width: 100%;
            padding-top: 18px;
            padding-bottom: 14px;
            border-bottom: 1px solid #E8DDE3;
            table-layout: fixed;
        }

        .header-left {
            display: table-cell;
            width: 60%;
            vertical-align: middle;
        }

        .header-right {
            display: table-cell;
            width: 40%;
            text-align: right;
            vertical-align: middle;
        }

        .brand-name {
            margin: 0;
            color: #B06A8D;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.4px;
        }

        .brand-subtext {
            margin-top: 5px;
            color: #5F6673;
            font-size: 12px;
        }

        .invoice-heading {
            margin: 0;
            color: #1E1E1E;
            font-size: 24px;
            font-weight: 800;
            letter-spacing: 0.8px;
        }

        .invoice-label {
            margin-top: 5px;
            color: #B06A8D;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .invoice-meta {
            width: 100%;
            margin-top: 12px;
            border: 1px solid #E8DDE3;
            border-radius: 7px;
            background-color: #F8F1F5;
        }

        .invoice-meta-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .invoice-meta-table td {
            width: 25%;
            padding: 10px 12px;
            border-right: 1px solid #E8DDE3;
            vertical-align: top;
        }

        .invoice-meta-table td:last-child {
            border-right: none;
        }

        .meta-label {
            margin-bottom: 5px;
            color: #5F6673;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .meta-value {
            color: #1E1E1E;
            font-size: 12px;
            font-weight: 700;
        }

        .party-table {
            width: 100%;
            margin: 15px 0 20px;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .party-table > tbody > tr > td {
            width: 50%;
            vertical-align: top;
        }

        .party-table > tbody > tr > td:first-child {
            padding-right: 6px;
        }

        .party-table > tbody > tr > td:last-child {
            padding-left: 6px;
        }

        .party-card {
            width: 100%;
            height: 178px;
            padding: 15px 16px;
            border: 1px solid #E8DDE3;
            border-radius: 9px;
            background-color: #FFFFFF;
        }

        .vendor-card {
            border-top: 3px solid #B06A8D;
        }

        .customer-card {
            border-top: 3px solid #C89AB5;
        }

        .party-inner-table {
            width: 100%;
            height: 100%;
            border-collapse: collapse;
        }

        .party-title {
            color: #B06A8D;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding-bottom: 6px;
        }

        .customer-card .party-title {
            color: #C89AB5;
        }

        .party-name {
            color: #1E1E1E;
            font-size: 15px;
            font-weight: 700;
            padding-bottom: 6px;
        }

        .party-line {
            color: #5F6673;
            font-size: 12px;
            line-height: 1.5;
            padding-bottom: 4px;
        }

        .party-line strong {
            color: #1E1E1E;
            font-weight: 700;
        }

        .gst-row {
            padding-top: 8px;
            border-top: 1px dashed #E8DDE3;
            color: #B06A8D;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.4;
            white-space: nowrap;
        }

        .customer-card .gst-row {
            color: #9A5A7C;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            border: 1px solid #E8DDE3;
            border-radius: 7px;
        }

        .items-table thead th {
            padding: 10px 8px;
            background-color: #B06A8D;
            color: #FFFFFF;
            font-size: 10px;
            font-weight: 700;
            text-align: left;
            text-transform: uppercase;
            letter-spacing: 0.25px;
            border-right: 1px solid rgba(255, 255, 255, 0.25);
        }

        .items-table thead th:last-child {
            border-right: none;
        }

        .items-table tbody td {
            padding: 10px 8px;
            color: #5F6673;
            font-size: 11.5px;
            line-height: 1.45;
            border-top: 1px solid #E8DDE3;
            border-right: 1px solid #E8DDE3;
            vertical-align: top;
        }

        .items-table tbody td:last-child {
            border-right: none;
        }

        .items-table tbody tr:nth-child(even) td {
            background-color: #FCF9FB;
        }

        .item-name {
            color: #1E1E1E;
            font-size: 12px;
            font-weight: 700;
        }

        .item-description {
            margin-top: 3px;
            color: #5F6673;
            font-size: 10px;
            line-height: 1.45;
        }

        .text-center { text-align: center !important; }
        .text-right { text-align: right !important; }

        .col-no { width: 5%; }
        .col-item { width: 37%; }
        .col-hsn { width: 12%; }
        .col-rate { width: 13%; }
        .col-qty { width: 8%; }
        .col-total { width: 25%; }

        .total-section {
            display: table;
            width: 100%;
            margin-top: 14px;
            table-layout: fixed;
        }

        .amount-words-wrapper {
            display: table-cell;
            width: 54%;
            padding-right: 7px;
            vertical-align: top;
        }

        .summary-wrapper {
            display: table-cell;
            width: 46%;
            padding-left: 7px;
            vertical-align: top;
        }

        .amount-words {
            min-height: 86px;
            padding: 13px 14px;
            border: 1px solid #E8DDE3;
            border-radius: 8px;
            background-color: #F8F1F5;
        }

        .section-label {
            margin-bottom: 7px;
            color: #B06A8D;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.4px;
        }

        .amount-value {
            color: #1E1E1E;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.5;
        }

        .summary-table {
            width: 100%;
            border-collapse: collapse;
            border: 1px solid #E8DDE3;
            border-radius: 8px;
        }

        .summary-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #E8DDE3;
            font-size: 11.5px;
        }

        .summary-table tr:last-child td {
            border-bottom: none;
        }

        .summary-label {
            color: #5F6673;
        }

        .summary-value {
            color: #1E1E1E;
            font-weight: 700;
            text-align: right;
        }

        .grand-total td {
            padding-top: 10px;
            padding-bottom: 10px;
            background-color: #B06A8D;
            color: #FFFFFF !important;
            font-size: 13px !important;
            font-weight: 800 !important;
        }

        .bottom-section {
            position: absolute;
            right: 10mm;
            bottom: 54px;
            left: 10mm;
        }

        .bottom-divider {
            width: 100%;
            height: 1px;
            margin-bottom: 12px;
            background-color: #E8DDE3;
        }

        .terms-signature-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        .terms-signature-table > tbody > tr > td {
            width: 50%;
            vertical-align: top;
        }

        .terms-cell {
            padding-right: 20px;
        }

        .signature-cell {
            padding-left: 20px;
            text-align: right;
        }

        .terms-title {
            margin-bottom: 7px;
            color: #1E1E1E;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.35px;
        }

        .terms-list {
            margin: 0;
            padding-left: 15px;
            color: #5F6673;
            font-size: 10px;
            line-height: 1.5;
        }

        .terms-list li {
            margin-bottom: 3px;
        }

        .signature {
            display: inline-block;
            min-width: 150px;
            text-align: center;
        }

        .signature-for {
            margin-bottom: 4px;
            color: #5F6673;
            font-size: 11px;
            text-align: center;
        }

        .signature-placeholder {
            height: 42px;
        }

        .signature-line {
            width: 150px;
            height: 1px;
            margin: 0 auto 5px;
            background-color: #1E1E1E;
        }

        .signature-name {
            color: #1E1E1E;
            font-size: 11.5px;
            font-weight: 700;
        }

        .signature-title {
            margin-top: 2px;
            color: #5F6673;
            font-size: 10px;
        }

        .page-footer-table {
            position: absolute;
            right: 10mm;
            bottom: 10px;
            left: 10mm;
            width: calc(100% - 20mm);
            border-collapse: collapse;
            border-top: 1px solid #E8DDE3;
            color: #5F6673;
            font-size: 10px;
        }

        .page-footer-table td {
            padding-top: 8px;
        }

        .footer-left {
            text-align: left;
            width: 70%;
        }

        .footer-right {
            color: #B06A8D;
            font-weight: 700;
            text-align: right;
            width: 30%;
        }
    </style>
</head>

<body>

    <div class="invoice-page">

        <div class="top-accent"></div>

        <div class="header">
            <div class="header-left">
                <div class="brand-name"><%= vendor.name %></div>
                <% if (vendor.subtext) { %>
                    <div class="brand-subtext"><%= vendor.subtext %></div>
                <% } %>
            </div>
            <div class="header-right">
                <div class="invoice-heading">TAX INVOICE</div>
                <div class="invoice-label">Original for Recipient</div>
            </div>
        </div>

        <div class="invoice-meta">
            <table class="invoice-meta-table">
                <tbody>
                    <tr>
                        <td>
                            <div class="meta-label">Invoice Number</div>
                            <div class="meta-value"><%= invoice.number %></div>
                        </td>
                        <td>
                            <div class="meta-label">Invoice Date</div>
                            <div class="meta-value"><%= invoice.date %></div>
                        </td>
                        <td>
                            <div class="meta-label">Place of Supply</div>
                            <div class="meta-value"><%= invoice.placeOfSupply %></div>
                        </td>
                        <td>
                            <div class="meta-label">Payment Terms</div>
                            <div class="meta-value"><%= invoice.paymentTerms %></div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <table class="party-table">
            <tbody>
                <tr>
                    <td>
                        <div class="party-card vendor-card">
                            <table class="party-inner-table">
                                <tr>
                                    <td vertical-align="top">
                                        <div class="party-title">Billed By / Service Provider</div>
                                        <div class="party-name"><%= vendor.name %></div>
                                        <div class="party-line"><%= vendor.address %></div>
                                        <div class="party-line">
                                            <strong>Email:</strong> <%= vendor.email %> &nbsp;&nbsp;|&nbsp;&nbsp; <strong>Mob:</strong> <%= vendor.phone %>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td vertical-align="bottom">
                                        <div class="gst-row">GSTIN: <%= vendor.gstin %></div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                    <td>
                        <div class="party-card customer-card">
                            <table class="party-inner-table">
                                <tr>
                                    <td vertical-align="top">
                                        <div class="party-title">Billed To / Customer Details</div>
                                        <div class="party-name"><%= customer.name %></div>
                                        <div class="party-line"><%= customer.address %></div>
                                        <div class="party-line">
                                            <strong>Contact:</strong> <%= customer.contactPerson %> &nbsp;(<%= customer.phone %>)
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td vertical-align="bottom">
                                        <div class="gst-row">GSTIN: <%= customer.gstin %></div>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

        <table class="items-table">
            <thead>
                <tr>
                    <th class="col-no text-center">#</th>
                    <th class="col-item">Item / Description</th>
                    <th class="col-hsn text-center">HSN/SAC</th>
                    <th class="col-rate text-right">Rate</th>
                    <th class="col-qty text-center">Qty</th>
                    <th class="col-total text-right">Amount</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach((item, index) => { %>
                    <tr>
                        <td class="text-center"><%= index + 1 %></td>
                        <td>
                            <div class="item-name"><%= item.name %></div>
                            <% if (item.description) { %>
                                <div class="item-description"><%= item.description %></div>
                            <% } %>
                        </td>
                        <td class="text-center"><%= item.hsnSac %></td>
                        <td class="text-right"><%= item.rate.toFixed(2) %></td>
                        <td class="text-center"><%= item.qty %></td>
                        <td class="text-right"><%= (item.rate * item.qty).toFixed(2) %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>

        <div class="total-section">
            <div class="amount-words-wrapper">
                <div class="amount-words">
                    <div class="section-label">Amount in Words</div>
                    <div class="amount-value"><%= totals.amountInWords %></div>
                </div>
            </div>
            <div class="summary-wrapper">
                <table class="summary-table">
                    <tbody>
                        <tr>
                            <td class="summary-label">Taxable Amount</td>
                            <td class="summary-value"><%= totals.taxableAmount.toFixed(2) %></td>
                        </tr>
                        <% if (totals.cgstAmount > 0) { %>
                            <tr>
                                <td class="summary-label">CGST (<%= totals.cgstRate %>%)</td>
                                <td class="summary-value"><%= totals.cgstAmount.toFixed(2) %></td>
                            </tr>
                        <% } %>
                        <% if (totals.sgstAmount > 0) { %>
                            <tr>
                                <td class="summary-label">SGST (<%= totals.sgstRate %>%)</td>
                                <td class="summary-value"><%= totals.sgstAmount.toFixed(2) %></td>
                            </tr>
                        <% } %>
                        <% if (totals.igstAmount > 0) { %>
                            <tr>
                                <td class="summary-label">IGST (<%= totals.igstRate %>%)</td>
                                <td class="summary-value"><%= totals.igstAmount.toFixed(2) %></td>
                            </tr>
                        <% } %>
                        <tr class="grand-total">
                            <td>Grand Total</td>
                            <td class="text-right"><%= totals.grandTotal.toFixed(2) %></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="bottom-section">
            <div class="bottom-divider"></div>
            <table class="terms-signature-table">
                <tbody>
                    <tr>
                        <td class="terms-cell">
                            <div class="terms-title">Terms & Conditions</div>
                            <ol class="terms-list">
                                <li>Goods/Services once supplied are non-refundable.</li>
                                <li>Payment is due according to agreed terms.</li>
                                <li>Subject to local jurisdiction.</li>
                            </ol>
                        </td>
                        <td class="signature-cell">
                            <div class="signature">
                                <div class="signature-for">For <%= vendor.name %></div>
                                <div class="signature-placeholder"></div>
                                <div class="s
